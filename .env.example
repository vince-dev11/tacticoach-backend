# Database
DATABASE_URL="mysql://user:password@localhost:3306/tacticoach"

# Server
PORT=3001
NODE_ENV=development

# JWT — generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3 (optional for local development)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=tacticoach-uploads

# CORS — comma-separated allowed origins.
# In development, localhost and 127.0.0.1 origins are also allowed automatically.
CORS_ORIGINS=http://localhost:5280,https://tacticoach.co.uk,https://www.tacticoach.co.uk

# SMTP (optional — emails are skipped when unset)
# Recommended (free, 300 emails/day): Brevo — SMTP_HOST=smtp-relay.brevo.com,
# SMTP_USER = the SMTP login on Brevo's "SMTP & API" page, SMTP_PASS = an SMTP key.
# Setup steps (domain DNS, webhook): TACTICAL_COACH/Email_And_Stripe_Setup_2026-10-20.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Bounce webhook: any long random string; give Brevo the URL
#   https://tacticoach.co.uk/api/webhooks/email?token=<this value>
EMAIL_WEBHOOK_TOKEN=
# The 60-second "we'll show you round" video linked from the personal welcome
# (Admin → Users → Personal welcome). Unset = the email goes without it.
WELCOME_VIDEO_URL=
# Email addresses. With Gmail SMTP all three must be the Gmail account
# (Gmail only sends as itself), e.g. "TactiCoach <tacticoach.co.uk@gmail.com>".
# When the domain mailboxes exist:
#   MAIL_FROM="TactiCoach <no-reply@tacticoach.co.uk>"   automatic emails
#   SUPPORT_EMAIL=info@tacticoach.co.uk                  contact form + every Reply-To
#   TEAM_MAIL_FROM="TactiCoach <info@tacticoach.co.uk>"  emails written in Admin
MAIL_FROM="TactiCoach <tacticoach.co.uk@gmail.com>"
SUPPORT_EMAIL=tacticoach.co.uk@gmail.com
TEAM_MAIL_FROM=

# Frontend base URL (checkout redirects, invite + reset links)
FRONTEND_URL=http://localhost:5280
# Production: FRONTEND_URL=https://tacticoach.co.uk (every link in an email starts here)

# Stripe (optional — billing routes return 503 when unset). Going live is
# only these two: products, prices and the billing portal are created by the
# API on first use. Webhook endpoint: https://tacticoach.co.uk/api/webhooks/stripe
# (events: checkout.session.completed, invoice.payment_succeeded, charge.refunded,
#  customer.subscription.updated, customer.subscription.deleted).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Book sales go live with Stripe; set false to keep the shop closed.
BOOK_SALES=true

# Gemini AI (optional — AI tactics routes return 503 when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Company owner account — unlocks /admin (blog CMS + CRM)
OWNER_EMAIL=

# Local-disk upload storage — the automatic fallback when the AWS_* values above
# are unset. Uploads (board videos, thumbnails, drill-sheet images, club logos)
# are written here and served from the API at /uploads/<key>.
#
# Default when unset: ~/tacticoach-storage/uploads
# Deliberately OUTSIDE the repository — this is coaches' data, not source, so it
# must not sit in the working tree where a clean checkout or a deploy wipes it.
# The API prints the resolved path at boot.
#
# In production, either configure S3 above or point this at a persistent mounted
# volume; local disk on a container is erased on every redeploy.
# UPLOADS_DIR=/var/lib/tacticoach/uploads
# PUBLIC_API_URL=http://localhost:3001

# Alternative AI provider (OpenAI-compatible: NVIDIA NIM, OpenAI, Groq…)
# AI_PROVIDER=openai-compat
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_API_KEY=
# AI_MODEL=nvidia/nemotron-3-super-120b-a12b

# Ask — the coach help assistant (21 Oct 2026). Off unless true. Uses the AI
# provider above when set; without one it still answers as a help search.
ASSISTANT_ENABLED=
# Where the frontend build's help-knowledge/<lang>.json is served. Default: FRONTEND_URL.
HELP_KNOWLEDGE_URL=

# ── Error tracking (Sentry) ─────────────────────────────────────────────────
# Optional. Nothing is reported until SENTRY_DSN is set. Create a Node.js
# project at sentry.io → Settings → Client Keys (DSN). See
# TACTICAL_COACH/Error_Tracing_Guide.md for the full walkthrough.
# Errors are registered from PRODUCTION only (NODE_ENV=production). A local
# API with the DSN set reports nothing; SENTRY_FORCE=1 tests the wiring.
SENTRY_DSN=
SENTRY_FORCE=
# production | staging — defaults to NODE_ENV.
SENTRY_ENVIRONMENT=production
# Set by the deploy to the git SHA, e.g. $(git rev-parse --short HEAD).
SENTRY_RELEASE=
# Share of requests performance-traced (0–1). 0.1 = 10%.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Admin → Analytics (read-only keys for the admin panel) ─────────────────
# Each source is optional; the page shows "Not connected" for any missing one.
# See TACTICAL_COACH/Admin_Analytics_Setup.md.
# GA4: Admin → Property settings → Property ID (a number). Service account
# key: paste the JSON, or the path to the downloaded key file.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=/var/www/secrets/ga4-service-account.json
# PostHog: personal API key with "Query Read"; project ID from project settings.
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Sentry: organisation auth token with org:read + project:read. EU region
# uses https://de.sentry.io.
SENTRY_API_URL=https://de.sentry.io
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_API=tacticoach-api
SENTRY_PROJECT_WEB=tacticoach-web

# PageSpeed Insights (Admin → Analytics → Health → Website speed).
# Without a key, Google's shared quota is usually used up ("429 Quota exceeded").
# Free key: Google Cloud console → enable "PageSpeed Insights API" → Credentials →
# Create API key → restrict it to that API. Free quota: 25,000 queries a day.
PAGESPEED_API_KEY=
# Page to test; defaults to FRONTEND_URL.
PAGESPEED_URL=

# VERIFY-GATE: the day "verify your email first" began (accounts older get 7 days grace). Default 2026-10-16.
# EMAIL_VERIFY_GATE_FROM=2026-10-16
# Local only: EMAIL_VERIFY_GATE=off lets the live Playwright suite's fresh accounts work (ignored in production).
# EMAIL_VERIFY_GATE=off
