# Database
DATABASE_URL="mysql://user:password@localhost:3306/tacticoach"

# Server
PORT=3001
NODE_ENV=development

# JWT — generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3 (optional for local development)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=tacticoach-uploads

# CORS — comma-separated allowed origins.
# In development, localhost and 127.0.0.1 origins are also allowed automatically.
CORS_ORIGINS=http://localhost:5280,https://yourdomain.com

# SMTP (optional — emails are skipped when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="TactiCoach <no-reply@tacticoach.co.uk>"
# Contact-form submissions are delivered here (defaults to MAIL_FROM)
SUPPORT_EMAIL=

# Frontend base URL (checkout redirects, invite + reset links)
FRONTEND_URL=http://localhost:5280

# Stripe (optional — billing routes return 503 when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gemini AI (optional — AI tactics routes return 503 when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Company owner account — unlocks /admin (blog CMS + CRM)
OWNER_EMAIL=

# Local-disk upload storage — the automatic fallback when the AWS_* values above
# are unset. Uploads (board videos, thumbnails, drill-sheet images, club logos)
# are written here and served from the API at /uploads/<key>.
#
# Default when unset: ~/tacticoach-storage/uploads
# Deliberately OUTSIDE the repository — this is coaches' data, not source, so it
# must not sit in the working tree where a clean checkout or a deploy wipes it.
# The API prints the resolved path at boot.
#
# In production, either configure S3 above or point this at a persistent mounted
# volume; local disk on a container is erased on every redeploy.
# UPLOADS_DIR=/var/lib/tacticoach/uploads
# PUBLIC_API_URL=http://localhost:3001

# Alternative AI provider (OpenAI-compatible: NVIDIA NIM, OpenAI, Groq…)
# AI_PROVIDER=openai-compat
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_API_KEY=
# AI_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Error tracking (Sentry) ─────────────────────────────────────────────────
# Optional. Nothing is reported until SENTRY_DSN is set. Create a Node.js
# project at sentry.io → Settings → Client Keys (DSN). See
# TACTICAL_COACH/Error_Tracing_Guide.md for the full walkthrough.
SENTRY_DSN=
# production | staging — defaults to NODE_ENV.
SENTRY_ENVIRONMENT=production
# Set by the deploy to the git SHA, e.g. $(git rev-parse --short HEAD).
SENTRY_RELEASE=
# Share of requests performance-traced (0–1). 0.1 = 10%.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Admin → Analytics (read-only keys for the admin panel) ─────────────────
# Each source is optional; the page shows "Not connected" for any missing one.
# See TACTICAL_COACH/Admin_Analytics_Setup.md.
# GA4: Admin → Property settings → Property ID (a number). Service account
# key: paste the JSON, or the path to the downloaded key file.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=/var/www/secrets/ga4-service-account.json
# PostHog: personal API key with "Query Read"; project ID from project settings.
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# Sentry: organisation auth token with org:read + project:read. EU region
# uses https://de.sentry.io.
SENTRY_API_URL=https://de.sentry.io
SENTRY_API_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_API=tacticoach-api
SENTRY_PROJECT_WEB=tacticoach-web
