{
  "name": "tacticoach-api",
  "version": "1.0.0",
  "description": "TactiCoach backend API — Fastify + Prisma + MySQL",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/eval-ai.ts",
    "db:deploy": "prisma migrate deploy",
    "uploads:migrate": "node scripts/migrate-uploads.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "//overrides": [
    "Security patches for transitive deps Prisma pins to exact versions, so",
    "`npm audit fix` reports 'no fix available' and only offers a Prisma major",
    "downgrade. Patched releases do exist; these pull them in and can be dropped",
    "once Prisma ships adapter/CLI releases that depend on them directly.",
    "  mariadb      — GHSA-cqhc-2h57-wpxf, GHSA-42r5-vhpq-m858, GHSA-g5xc-5w98-jfvm.",
    "                 Ships to PRODUCTION via @prisma/adapter-mariadb (the DB driver",
    "                 the API actually connects with), so this one matters most.",
    "  mysql2       — GHSA-3f6p-5ww8-9rcr, GHSA-rgwj-5xj2-c3m3. Dev-only (prisma CLI).",
    "  deepmerge-ts — GHSA-ggr8-5vv4-36mx. Dev-only (prisma CLI via @prisma/config)."
  ],
  "overrides": {
    "mariadb": "3.4.7",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.20.2",
    "stripe": "^22.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.0.0",
    "@types/pdfkit": "^0.17.6",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^4.0.0"
  }
}
