generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id               Int       @id @default(autoincrement())
  // 'owner' unlocks the /admin area (blog CMS + CRM). Assigned only via the
  // OWNER_EMAIL env var — never through the API.
  role             Role      @default(user)
  /// What the person SAID they are at signup. Segmentation and onboarding
  /// routing only — never authorisation. What an account can actually do is
  /// always resolved by lib/entitlements (subscription + club seat + collaboration),
  /// and whether someone is "really" a club is the Club row plus an active
  /// owner subscription. The two can legitimately disagree: a coach invited to
  /// a club later still says `coach`, and someone who picks `club` and never
  /// takes the plan is a sales lead, not a club.
  accountType      AccountType @default(coach) @map("account_type")
  name             String    @db.VarChar(100)
  surname          String    @db.VarChar(100)
  email            String    @unique @db.VarChar(191)
  phone            String?   @db.VarChar(30)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  clubName         String?   @map("club_name") @db.VarChar(150)
  clubLogoUrl      String?   @map("club_logo_url") @db.VarChar(500)
  clubLogoKey      String?   @map("club_logo_key") @db.VarChar(500)
  // Social links shown on exported drill sheets.
  instagramUrl     String?   @map("instagram_url") @db.VarChar(300)
  youtubeUrl       String?   @map("youtube_url") @db.VarChar(300)
  twitterUrl       String?   @map("twitter_url") @db.VarChar(300)
  facebookUrl      String?   @map("facebook_url") @db.VarChar(300)
  // Who this coach works with. Set once, used by every AI generation: age fixes
  // the playing format, the format caps the squad size, and both decide which
  // concepts are appropriate at all. Stored as plain strings rather than enums
  // so adding an age group is a code change, not a migration.
  coachAgeGroup    String?   @map("coach_age_group") @db.VarChar(16)
  coachFormat      String?   @map("coach_format") @db.VarChar(16)
  coachLevel       String?   @map("coach_level") @db.VarChar(24)
  /// The team's usual shape ("2-3-1" at 7v7) and typical squad size. Both feed
  /// the AI context; both validated against the format at resolution time.
  coachFormation   String?   @map("coach_formation") @db.VarChar(12)
  coachSquadSize   Int?      @map("coach_squad_size")
  // ---- Coach branding: the coach's own public page (/coach/:slug) ----
  // Solo coaches have no Club row, so this is the only branded presence most
  // users get. Auto-live (no review) once the slug is set, the page is
  // enabled, the plan is active and something is published.
  coachSlug        String?   @unique @map("coach_slug") @db.VarChar(60)
  coachPhotoKey    String?   @map("coach_photo_key") @db.VarChar(500)
  coachColor       String?   @map("coach_color") @db.VarChar(9)
  coachBio         String?   @map("coach_bio") @db.Text
  /// Role / qualification line under the name ("UEFA B · Head coach U13").
  coachTitle       String?   @map("coach_title") @db.VarChar(80)
  coachPageEnabled Boolean   @default(true) @map("coach_page_enabled")
  /// Public-page facts a parent or club reads before they trust a coach.
  /// All optional; the page simply omits what is blank.
  coachingSince        Int?     @map("coaching_since")
  coachQualifications  String?  @map("coach_qualifications") @db.VarChar(160)
  /// One line of philosophy ("Brave on the ball, ruthless in the press").
  /// Doubles as the page's meta description, so it's capped hard.
  coachPhilosophy      String?  @map("coach_philosophy") @db.VarChar(200)
  coachLocation        String?  @map("coach_location") @db.VarChar(120)
  /// Opt-in: shows a "Message coach" form that relays to the account email
  /// without ever exposing the address.
  coachContactEnabled  Boolean  @default(false) @map("coach_contact_enabled")
  /// Guided tours this account has completed (["editor","sheet"]). Account-level
  /// (not localStorage) so a coach sees each tour exactly once across devices.
  toursDone        Json      @default("[]") @map("tours_done")
  stripeCustomerId String?   @unique @map("stripe_customer_id") @db.VarChar(191)
  emailVerifiedAt  DateTime? @map("email_verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  subscription        UserSubscription?
  boards              CanvasBoard[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  boardLikes          BoardLike[]
  // Purchased top-up credits (never expire) — spent only after the plan's
  // monthly allowance is exhausted.
  bonusCredits Int @default(0) @map("bonus_credits")

  ownedClub       Club?             @relation("ClubOwner")
  /// Roster rows this account is linked to — one per coach who added them.
  squadEntries    SquadPlayer[]     @relation("SquadPlayerAccount")
  /// Feedback this user has WRITTEN (as a coach).
  writtenNotes    PlayerNote[]      @relation("CoachNotes")
  clubMembership  ClubMember?
  drillSheets     DrillSheet[]
  drillSheetLikes DrillSheetLike[]
  trainingSessions TrainingSession[]
  squads          Squad[]
  squadPlayers    SquadPlayer[]
  aiUsage         AiUsage[]
  aiCorrections   AiCorrection[]
  challengeSubmissions ChallengeSubmission[]
  challengeVotes       ChallengeVote[]

  /// This coach's own invite code — and the same code when they are a
  /// collaborator, so a link already on their slides keeps working the day
  /// they sign. Minted lazily on first use, never reassigned.
  referralCode String? @unique @map("referral_code") @db.VarChar(24)

  seasonPlans      SeasonPlan[]
  /// Emails sent TO this account, and emails this account (an admin) sent.
  emailsReceived   EmailLog[]       @relation("EmailLogSubject")
  emailsSent       EmailLog[]       @relation("EmailLogActor")
  referralsMade    Referral[]       @relation("Referrer")
  referralReceived Referral?        @relation("Referred")
  referralRewards  ReferralReward[]
  collaborator     Collaborator?
  collaborationEarnings CollaboratorCommission[]
  collaborationApplications CollaborationApplication[]
  agreements       AgreementAcceptance[]
  ebooks           Ebook[]
  ebookNotes       EbookNote[]
  ebookProgress    EbookProgress[]
  videoExports     VideoExport[]

  ebookReviews EbookReview[]

  @@map("users")
}

/// One coach introducing another. At most one row per referred user — being
/// referred is a property of an account, decided once at signup and never
/// reassigned, which is what stops two collaborators claiming the same customer.
///
/// `pending` until the referred coach's first payment actually clears. That is
/// the whole anti-fraud design: creating accounts costs nothing, so nothing is
/// earned for creating them.
model Referral {
  id             Int            @id @default(autoincrement())
  referrerId     Int            @map("referrer_id")
  referredUserId Int            @unique @map("referred_user_id")
  /// The code as typed/clicked — kept even if the referrer's code changes later,
  /// so a statement can always show how the credit was attributed.
  code           String         @db.VarChar(24)
  status         ReferralStatus @default(pending)
  /// The plan the new customer BOUGHT. Decided at their FIRST PAYMENT and not
  /// revisited: a coach who upgrades to Club later already earned their
  /// referrer the reward for what they actually bought, and moving it would
  /// mean retracting one payout to make another.
  referredPlan   String         @default("pro") @map("referred_plan") @db.VarChar(32)
  /// The plan the REFERRER was on when this qualified. Locked in here rather
  /// than read live, because a coach who upgrades would otherwise have their
  /// rate jump mid-programme and rewards they already hold would stop being
  /// "owed" — the recompute would try to take them back.
  referrerPlan   String         @default("pro") @map("referrer_plan") @db.VarChar(32)
  /// The referred customer's first cleared payment, and the invoice that was.
  /// The invoice id is kept so a retried webhook cannot be mistaken for a
  /// second payment — see the monthly bar in referrals.service.ts.
  firstPaymentAt  DateTime?     @map("first_payment_at")
  firstInvoiceId  String?       @map("first_invoice_id") @db.VarChar(191)
  /// Their second cleared payment. A MONTHLY customer has only handed over one
  /// instalment when the reward would otherwise be earned, so monthly waits
  /// for this one. Annual banks the whole year up front and never needs it.
  secondPaymentAt DateTime?     @map("second_payment_at")
  qualifiedAt    DateTime?      @map("qualified_at")
  reversedAt     DateTime?      @map("reversed_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, status, referrerPlan, referredPlan])
  @@map("referrals")
}

enum ReferralStatus {
  pending
  qualified
  reversed
}

/// A club is worth roughly eight coaches, so the two earn on separate ladders.
/// A player subscription is worth a fraction of a coach's, so its rungs are
/// correspondingly longer — see lib/referral-ladder.ts.
/// The plan the referrer holds. A free month is worth £2.99 to a Pro coach and
/// £24.99 to a Club, so a Club has to bring about twice as many people for it.
/// A rung of the referral ladder that has been reached and paid out.
///
/// The unique key is the idempotency guard: the ladder is recomputed from
/// scratch on every qualifying event, so without it a coach sitting on 8
/// referrals would be granted tier 3 and tier 8 again on every recount.
model ReferralReward {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  /// Which pairing paid this out: the referrer's plan and what they brought.
  referrerPlan String    @default("pro") @map("referrer_plan") @db.VarChar(32)
  referredPlan String    @default("pro") @map("referred_plan") @db.VarChar(32)
  /// Which award this is on that pairing (1-based). With the two plan slugs
  /// it is the idempotency key: a recompute after a webhook retry produces
  /// the same award numbers and the unique index rejects the duplicate.
  cycle     Int
  /// How many referrals this award took — the rate in force when it was
  /// earned. Recorded rather than looked up later, so a price change never
  /// restates history. See referral-ladder.ts.
  every     Int
  /// Free months this award adds.
  months    Int
  grantedAt DateTime  @default(now()) @map("granted_at")
  /// When the months were actually put on the account. Unapplied rewards can
  /// still be revoked if the referral behind them is reversed.
  appliedAt DateTime? @map("applied_at")
  /// Set when a reversal took the count back below this rung.
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, referrerPlan, referredPlan, cycle])
  @@index([userId])
  @@map("referral_rewards")
}

/// An invited coach on the commercial Collaboration Programme: paid commission
/// instead of credit, and a comped account so they can demo what they sell.
model Collaborator {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique @map("user_id")
  status         CollaboratorStatus @default(invited)
  /// Share of the net subscription fee, as FRACTIONS: 0.1500 is 15%.
  ///
  /// Two rates, because a club is a harder sale than a coach — a committee
  /// decision over months rather than one person deciding in minutes. Which
  /// applies is resolved PER INVOICE, from the plan that invoice is for, so a
  /// coach who upgrades to a club plan moves their collaborator up from that
  /// invoice onward. See rateForPlan in collaborations.service.ts.
  ///
  /// Defaults for new collaborators only — anyone already invited keeps the
  /// rates their signed agreement states.
  coachRate      Decimal       @default(0.1500) @map("coach_rate") @db.Decimal(6, 4)
  clubRate       Decimal       @default(0.2000) @map("club_rate") @db.Decimal(6, 4)
  /// Trading name on the agreement, if they signed as a business.
  companyName    String?       @map("company_name") @db.VarChar(150)
  /// Set when the collaborator accepted in the app. Until then `status` is `invited`
  /// and nothing is comped — a comped account handed out before anyone agreed to
  /// anything is the whole reason this state exists.
  agreementSignedAt DateTime?  @map("agreement_signed_at")
  /// Which version of the text they accepted. Stored, not derived, so changing
  /// the agreement later never rewrites what somebody already agreed to.
  agreementVersion  String?    @map("agreement_version") @db.VarChar(16)
  /// Recorded at acceptance. The only useful evidence if it is ever disputed.
  agreementIp       String?    @map("agreement_ip") @db.VarChar(64)
  startedAt      DateTime      @default(now()) @map("started_at")
  endedAt        DateTime?     @map("ended_at")
  notes          String?       @db.Text

  // ---- Public directory ----------------------------------------------------
  // THREE conditions to appear, all required: `status = active`, `listed`, and
  // `profileApproved`. Two booleans rather than one because they answer
  // different questions — the collaborator's consent, and our moderation —
  // and collapsing them would let either one publish somebody on its own.
  /// Their choice. Default false: nobody is published by accident.
  listed          Boolean      @default(false)
  /// An admin has read the words and opened every link. Reset to false
  /// whenever the profile is edited, so moderation cannot approve one version
  /// and publish another.
  profileApproved Boolean      @default(false) @map("profile_approved")
  displayName     String?      @map("display_name") @db.VarChar(160)
  roleTitle       String?      @map("role_title") @db.VarChar(120)
  organisation    String?      @db.VarChar(160)
  location        String?      @db.VarChar(120)
  photoKey        String?      @map("photo_key") @db.VarChar(255)
  bio             String?      @db.VarChar(600)
  links           String?      @db.VarChar(1000)
  /// Set at first publish and never changed — a directory URL that moves is a
  /// link somebody already shared that now 404s.
  slug            String?      @unique @db.VarChar(80)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions CollaboratorCommission[]

  @@index([status, listed, profileApproved])
  @@map("collaborators")
}

/// An application to the Collaboration Programme, from the public form.
///
/// A SEPARATE TABLE from `Collaborator`, not a status on it. An application is
/// a request from somebody who may not even have an account, and most will
/// never become a collaborator; folding it in would mean every "who are my
/// collaborators" query first had to remember to exclude the people who merely
/// asked.
///
/// A rejected application is KEPT. It is the answer to "did we already say no
/// to this club in March", and it is what stops the same person being approved
/// twice by two different people.
model CollaborationApplication {
  id             Int      @id @default(autoincrement())
  /// Nullable: the form is public and most applicants have no account yet.
  userId         Int?     @map("user_id")
  name           String   @db.VarChar(160)
  email          String   @db.VarChar(255)
  /// What they are applying AS — not the same as their account type. A coach
  /// at a club may apply on the club's behalf.
  applicantKind  ApplicantKind @default(coach) @map("applicant_kind")
  organisation   String?  @db.VarChar(160)
  location       String?  @db.VarChar(120)
  links          String?  @db.VarChar(1000)
  /// Self-reported and unverified, in their own words: "about 400 across two
  /// newsletters" tells a reviewer more than 400 with no provenance.
  audience       String?  @db.VarChar(200)
  why            String?  @db.Text
  /// TWO consents, deliberately separate. Agreeing to be contacted is not
  /// agreeing to be published on our website.
  consentContact Boolean  @default(false) @map("consent_contact")
  consentListing Boolean  @default(false) @map("consent_listing")
  status         ApplicationStatus @default(submitted)
  /// Ours, not theirs — kept apart from `why` so an applicant's own words can
  /// never be confused with something we wrote about them.
  reviewNote     String?  @map("review_note") @db.VarChar(1000)
  reviewedAt     DateTime? @map("reviewed_at")
  /// Single-use and time-limited. Emailed on approval to an applicant with no
  /// account, so they can create one and land straight on the agreement.
  inviteToken    String?  @unique @map("invite_token") @db.VarChar(64)
  inviteExpiresAt DateTime? @map("invite_expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Not unique on email: somebody refused in March may reasonably apply again
  /// in September, and a unique index would make the second attempt a 500.
  @@index([email])
  @@index([status, createdAt])
  @@map("collaboration_applications")
}

enum ApplicantKind {
  coach
  club
}

enum ApplicationStatus {
  submitted
  approved
  rejected
}

enum CollaboratorStatus {
  /// Invited, agreement not yet accepted. No commission, no comped account.
  invited
  active
  suspended
  ended
}

/// One line on a collaborator's statement: commission owed on one cleared payment.
///
/// Amounts are stored in minor units (pence) as integers. Money in a Decimal
/// read back through a JS number is a rounding bug waiting to be discovered at
/// the worst possible moment — when someone disputes their invoice.
model CollaboratorCommission {
  id                Int       @id @default(autoincrement())
  collaboratorId    Int       @map("collaborator_id")
  /// The referred customer this line is for.
  customerId        Int       @map("customer_id")
  /// Stripe invoice that produced it — the dedupe key for webhook retries.
  providerInvoiceId String    @unique @map("provider_invoice_id") @db.VarChar(191)
  /// What the customer actually paid, excluding VAT.
  netAmount         Int       @map("net_amount")
  /// Rate applied at the time — a later rate change must not restate history.
  rate              Decimal   @db.Decimal(6, 4)
  commissionAmount  Int       @map("commission_amount")
  currency          String    @default("GBP") @db.VarChar(3)
  /// Set when the payment was refunded or charged back: the line is reversed,
  /// not deleted, so the statement still explains itself.
  reversedAt        DateTime? @map("reversed_at")
  paidOutAt         DateTime? @map("paid_out_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([collaboratorId, createdAt])
  @@map("collaborator_commissions")
}

/// One row per successful AI generation — the plan's monthly allowance is
/// enforced by counting rows in the current calendar month (no refill job).
model AiUsage {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  kind      AiKind
  createdAt DateTime @default(now()) @map("created_at")
  /// Fingerprint of the prompt (not the prompt) — powers the free retry.
  promptHash String? @map("prompt_hash") @db.VarChar(16)
  /// True when this generation was a free retry: recorded, but not charged.
  freeRetry Boolean @default(false) @map("free_retry")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, promptHash, createdAt])
  @@map("ai_usage")
}

/// A coach's correction of an AI generation: the difference between what we
/// drew and what they saved. The most honest quality signal we can collect —
/// a regenerate click says "something was off"; a moved centre-back says what.
/// Each row stores a compact structured DIFF, never the full board, so it stays
/// small and carries only what the coach changed.
model AiCorrection {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// What produced the original: 'dsl' (compiler) or 'gemini' (fallback).
  source String @db.VarChar(12)
  /// Concept card matched at generation time ('unknown' when none).
  concept String @db.VarChar(40)
  /// Tactical quality score the generation received (0-100).
  quality Int
  /// Same privacy-preserving fingerprint AiUsage stores — joins a correction
  /// to its generation without keeping the prompt text twice.
  promptHash String? @map("prompt_hash") @db.VarChar(16)
  /// Coach context at generation time, e.g. "u9/7v7" — corrections from a
  /// youth session and a senior one indicate different fixes.
  context String? @db.VarChar(40)

  /// The structured diff: moved/added/removed objects and movement edits.
  /// See ai.corrections.ts for the exact shape and the size cap.
  diff Json

  /// Aggregates, denormalised so the summary endpoint never parses JSON:
  movedCount   Int @map("moved_count")
  addedCount   Int @map("added_count")
  removedCount Int @map("removed_count")
  /// Mean distance moved across corrected objects, in canvas units.
  meanShift Int @map("mean_shift")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([concept, createdAt])
  @@index([source, createdAt])
  @@map("ai_corrections")
}

enum AiKind {
  layout
  animation
  reel
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(191)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Single-use password-reset tokens. Only the SHA-256 hash of the token is stored,
// so a DB leak can't be used to reset accounts. Expires after a short window.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Membership plans — pricing to be decided; price fields nullable until set.
model MembershipPlan {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  slug           String   @unique @db.VarChar(50)
  description    String?  @db.Text
  monthlyPrice   Decimal? @map("monthly_price") @db.Decimal(10, 2)
  annualPrice    Decimal? @map("annual_price") @db.Decimal(10, 2)
  currency       String   @default("EUR") @db.VarChar(3)
  features       Json     @default("[]")
  maxBoards      Int?     @map("max_boards")
  maxTeamMembers Int?     @map("max_team_members")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscriptions UserSubscription[]

  @@map("membership_plans")
}

model UserSubscription {
  id                     Int                @id @default(autoincrement())
  userId                 Int                @unique @map("user_id")
  planId                 Int                @map("plan_id")
  status                 SubscriptionStatus @default(trial)
  billingCycle           BillingCycle?      @map("billing_cycle")
  startedAt              DateTime           @default(now()) @map("started_at")
  expiresAt              DateTime?          @map("expires_at")
  // Set once the "trial ends in 2 days" reminder email has gone out (dedupe).
  trialReminderSentAt    DateTime?          @map("trial_reminder_sent_at")
  cancelledAt            DateTime?          @map("cancelled_at")
  paymentProvider        String?            @map("payment_provider") @db.VarChar(50)
  providerSubscriptionId String?            @map("provider_subscription_id") @db.VarChar(255)
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("user_subscriptions")
}

enum SubscriptionStatus {
  trial
  active
  cancelled
  expired
}

enum BillingCycle {
  monthly
  annual
}

model CanvasBoard {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  title        String    @db.VarChar(255)
  pitchKey     String?   @map("pitch_key") @db.VarChar(50)
  state        Json      @default("{}")
  // S3 object keys — URLs are presigned on read, never stored.
  thumbnailKey String?   @map("thumbnail_key") @db.VarChar(500)
  videoKey     String?   @map("video_key") @db.VarChar(500)
  // Legacy column kept for compatibility with earlier clients.
  thumbnailUrl String?   @map("thumbnail_url") @db.VarChar(500)
  // Boards are public by default (the create route also sets this explicitly).
  // Coaches can flip any board private from the library's visibility pill.
  published    Boolean   @default(true)
  publishedAt  DateTime? @map("published_at")
  // Set at save time so library cards can say "Animation" vs "Static board"
  // without loading the (large) state JSON per row.
  hasAnimation Boolean   @default(false) @map("has_animation")
  // Optional coach-chosen category tags ("pressing", "build-out", …) — they
  // filter the library AND label the board for future model training.
  tags         Json      @default("[]")
  // Silent snapshot of the coach's context at save time (age group, format,
  // level, formation). Attached server-side; the coach is never asked.
  contextSnapshot Json?  @map("context_snapshot")
  // Asked at save time (required in the editor): who this drill is FOR and
  // how hard it is. Explicit per board — unlike contextSnapshot, which is the
  // coach's profile default and may not match a one-off session.
  ageGroup     String?   @map("age_group") @db.VarChar(16)
  difficulty   String?   @db.VarChar(16)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes BoardLike[]
  challengeSubmissions ChallengeSubmission[]

  @@index([userId])
  @@index([published, publishedAt])
  playerNotes PlayerNote[]

  @@map("canvas_boards")
}

model BoardLike {
  id        Int      @id @default(autoincrement())
  boardId   Int      @map("board_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  board CanvasBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_likes")
}

// ---- Weekly tactical challenge (community engagement + free public content) --
//
// One scenario posted a week; coaches submit a board that answers it; the
// community votes; the top-voted submission when the window closes is the
// week's featured coach. No background job: "current winner" and "past
// winners" are both computed at read time from vote counts, never stored.

model Challenge {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(150)
  /// The scenario, in plain coaching language — shown as-is on the challenge card.
  prompt    String   @db.Text
  /// One of canvas.routes.ts's BOARD_TAGS, for a thematic accent colour/icon. Optional.
  tag       String?  @db.VarChar(20)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")

  submissions ChallengeSubmission[]

  @@index([startsAt, endsAt])
  @@map("challenges")
}

/// A coach's entry: one saved board pointed at one challenge. Unique per coach
/// per challenge (not per board) — re-submitting swaps which of their boards
/// is entered rather than stacking up multiple entries to vote-split.
model ChallengeSubmission {
  id          Int      @id @default(autoincrement())
  challengeId Int      @map("challenge_id")
  userId      Int      @map("user_id")
  boardId     Int      @map("board_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  board     CanvasBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  votes     ChallengeVote[]

  @@unique([challengeId, userId])
  @@index([boardId])
  @@map("challenge_submissions")
}

model ChallengeVote {
  id           Int      @id @default(autoincrement())
  submissionId Int      @map("submission_id")
  userId       Int      @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  submission ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([submissionId, userId])
  @@index([userId])
  @@map("challenge_votes")
}

// ---- Clubs (Club plan: owner buys seats, invites coaches) -------------------

model Club {
  id        Int      @id @default(autoincrement())
  ownerId   Int      @unique @map("owner_id")
  name      String   @db.VarChar(150)
  // ---- Brand kit (set once by the owner in Club → Branding) ----
  badgeKey       String?    @map("badge_key") @db.VarChar(500)
  primaryColor   String?    @map("primary_color") @db.VarChar(9)
  secondaryColor String?    @map("secondary_color") @db.VarChar(9)
  slug           String?    @unique @db.VarChar(80)
  bio            String?    @db.Text
  location       String?    @db.VarChar(150)
  foundedYear    Int?       @map("founded_year")
  websiteUrl     String?    @map("website_url") @db.VarChar(300)
  /// Age groups the club runs, free text ("U7–U16, adults").
  ageGroups      String?    @map("age_groups") @db.VarChar(120)
  // Public page lifecycle: content gate + owner submission + CRM approval.
  pageStatus      PageStatus @default(none) @map("page_status")
  pageSubmittedAt DateTime?  @map("page_submitted_at")
  pageReviewNote  String?    @map("page_review_note") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner   User         @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ClubMember[]
  invites ClubInvite[]
  photos  ClubPhoto[]

  @@map("clubs")
}

model ClubMember {
  id        Int      @id @default(autoincrement())
  clubId    Int      @map("club_id")
  userId    Int      @unique @map("user_id")
  /// An admin may act for every coach in the club — open their sessions and
  /// write player feedback in their own name. Granted by the OWNER only, one
  /// member at a time. The owner is an admin implicitly and has no row here
  /// (see lib/club-staff), because a club owner is never a member of their
  /// own club.
  role      ClubRole @default(member)
  createdAt DateTime @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("club_members")
}

/// A seat is a coach unless the owner says otherwise. Deliberately two values:
/// every extra tier is another person who can read what was written to a child.
enum ClubRole {
  member
  admin
}

model ClubInvite {
  id         Int       @id @default(autoincrement())
  clubId     Int       @map("club_id")
  email      String    @db.VarChar(255)
  token      String    @unique @db.VarChar(100)
  acceptedAt DateTime? @map("accepted_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("club_invites")
}

// ---- Drill sheets (data sheets — publishable, likeable) ---------------------

/// A full training session composed of ordered blocks (saved boards, drill
/// sheets, or plain text beats like "water break"), each with minutes. Blocks
/// REFERENCE library items rather than copying them, so fixing a drill once
/// updates every session that uses it. `brand` carries the coach's PDF
/// customisation (colour etc.) chosen for this session.
/// A coach's whole season: the top of the three-level plan (season → week →
/// session). A coach does not plan a session, he plans a season, and the
/// session is the last and smallest thing he opens.
model SeasonPlan {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  title        String   @db.VarChar(255)
  ageGroup     String?  @map("age_group") @db.VarChar(16)
  /// Free text as the coach writes it: "2026/27".
  seasonLabel  String?  @map("season_label") @db.VarChar(40)
  startDate    DateTime @map("start_date")
  /// 0 = Sunday … 6 = Saturday. A per-plan setting, not a profile setting —
  /// a coach can run an academy week and a senior week differently.
  weekStartsOn Int      @default(1) @map("week_starts_on")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks PlanWeek[]

  @@index([userId])
  @@map("season_plans")
}

/// One microcycle. Exists as a row rather than being derived from dates because
/// it carries the coach's own words — the week theme and the phase — which
/// nothing else can compute.
model PlanWeek {
  id        Int          @id @default(autoincrement())
  planId    Int          @map("plan_id")
  /// 1-based, counted from the plan's start date.
  weekIndex Int          @map("week_index")
  startDate DateTime     @map("start_date")
  /// "Build-up play against a mid block — match Saturday".
  theme     String?      @db.VarChar(255)
  phase     SeasonPhase  @default(in_season)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  plan     SeasonPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions TrainingSession[]

  @@unique([planId, weekIndex])
  @@index([planId])
  @@map("plan_weeks")
}

enum SeasonPhase {
  pre_season  @map("pre-season")
  in_season   @map("in-season")
  transition
}

/// What kind of session this is. Drives the colour a coach reads on all three
/// screens, so it lives in the database rather than being guessed from a title.
enum SessionType {
  physical
  technical
  tactical
  match
  recovery
  rest
}

model TrainingSession {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  title       String    @db.VarChar(255)
  sessionDate DateTime? @map("session_date")
  ageGroup    String?   @map("age_group") @db.VarChar(16)
  /// Which team this session is for. Null means the coach's default squad, so
  /// every session saved before squads existed keeps working untouched.
  squadId     Int?      @map("squad_id")
  /// Planned length in minutes (the target the running total is checked against).
  targetMinutes Int?    @map("target_minutes")
  /// Ordered blocks: [{ kind, refId?, title, minutes, note?, part? }]
  /// `part` groups blocks under warm-up / main / game / cool-down. Absent on
  /// blocks saved before the redesign; those fall into the main part.
  blocks      Json      @default("[]")
  /// PDF branding: { color?: '#0aa', showClubLogo?: boolean }
  brand       Json      @default("{}")

  // ---- Planner fields -------------------------------------------------------
  // All nullable. A session with no planWeekId is a standalone session and
  // behaves exactly as it did before the planner existed, so nothing a coach
  // has already saved breaks.

  planWeekId   Int?         @map("plan_week_id")
  sessionType  SessionType  @default(tactical) @map("session_type")
  /// Perceived intensity 1–10. Load is target_minutes × intensity_rpe and is
  /// DERIVED, never stored — a stored total drifts out of step with its parts.
  intensityRpe Int?         @map("intensity_rpe")
  /// Kick-off / start time as "18:00". A string, not a DateTime: it is a time
  /// of day in the coach's own timezone, and storing it as an instant makes it
  /// move when the clocks change.
  startTime    String?      @map("start_time") @db.VarChar(5)
  isMatch      Boolean      @default(false) @map("is_match")
  opponent     String?      @db.VarChar(120)
  venue        String?      @db.VarChar(120)
  /// Names of the session's parts, in order: ["Warm-up","Main part",…].
  /// Between 3 and 5. Empty means the default set.
  parts        Json         @default("[]")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting a week must not delete the coach's sessions.
  /// They fall back to being standalone sessions in his library.
  planWeek PlanWeek? @relation(fields: [planWeekId], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: archiving a team must never delete the sessions the
  /// coach ran with it. They fall back to the default squad.
  squad    Squad?    @relation(fields: [squadId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([squadId])
  @@index([planWeekId])
  @@index([userId, sessionDate])
  playerNotes PlayerNote[]

  @@map("training_sessions")
}

model DrillSheet {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  title       String    @db.VarChar(255)
  description String?   @db.Text
  data        Json      @default("{}")
  // S3 key of the rendered sheet image (preview shown in the gallery).
  imageKey    String?   @map("image_key") @db.VarChar(500)
  // Sheets are public by default (the create route also sets this explicitly).
  published   Boolean   @default(true)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes DrillSheetLike[]

  @@index([userId])
  @@index([published, publishedAt])
  @@map("drill_sheets")
}

model DrillSheetLike {
  id        Int      @id @default(autoincrement())
  sheetId   Int      @map("sheet_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  sheet DrillSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sheetId, userId])
  @@index([userId])
  @@map("drill_sheet_likes")
}

enum Role {
  user
  owner
}

/// Declared at signup; see User.accountType for why this grants nothing.
///
/// `player` exists ahead of any player-facing feature so the column is already
/// there when one is built. Until then a player account is parked on a holding
/// screen rather than dropped into a coach dashboard it cannot use.
enum AccountType {
  coach
  club
  player
}

/// A team the coach works with — "U13", "First team", "Thursday keepers".
///
/// Most coaches have exactly one, and the app never shows them a picker for
/// it. The ones who have two have a real problem without this: a merged list
/// means the feedback drawer offers every child the coach knows for a session
/// twenty of them were not at, and the editor's player shelf mixes age groups.
///
/// Owned by ONE coach. Club-wide shared squads are deliberately not modelled:
/// notes carry `coachUserId` and a club admin can already reach every coach's
/// sessions (see lib/club-staff), so shared ownership would buy nothing and
/// complicate who may edit whom.
model Squad {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(60)
  /// Optional, and only a label — the session's own ageGroup still drives the
  /// playing format and the AI.
  ageGroup  String?  @map("age_group") @db.VarChar(16)
  sortOrder Int      @default(0) @map("sort_order")
  /// Retired rather than deleted: sessions and notes reference it, and a
  /// coach who stops taking the U13s still has last season's feedback.
  archivedAt DateTime? @map("archived_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  players  SquadPlayer[]
  sessions TrainingSession[]

  @@index([userId, sortOrder])
  @@map("squads")
}

/// The coach's real players. Entered once in the profile; the editor's player
/// shelf and formation presets then place the coach's actual players — names
/// on the board, not anonymous numbers. Replaced as a whole per squad on save
/// (PUT /users/me/squad), so no per-row endpoints are needed.
model SquadPlayer {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  /// Which of this coach's teams. Back-filled for every existing row by
  /// migration 22; never null in practice.
  squadId   Int?     @map("squad_id")
  name      String   @db.VarChar(40)
  number    String   @db.VarChar(3)
  /// Free-ish position tag: GK / DF / MF / FW (validated in the route).
  position  String?  @db.VarChar(4)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ---- Player account link --------------------------------------------------
  // A player buys their own subscription and signs up themselves; the coach
  // then asks to link that account to this roster row. Null for most players —
  // a roster is complete long before anyone subscribes, and it has to keep
  // working either way.

  playerUserId Int?             @map("player_user_id")
  /// pending until the PLAYER accepts. A coach knowing an email address must
  /// never be enough to start writing to a child.
  linkStatus   SquadLinkStatus? @map("link_status")
  linkedAt     DateTime?        @map("linked_at")
  /// Where notifications are copied. For an under-16 this is the guardian's
  /// address. Set by the player in their own profile, not by the coach.
  guardianEmail String?         @db.VarChar(191) @map("guardian_email")

  /// Removed from the squad but kept because the notes written to this player
  /// are the PLAYER's record, not the coach's. A row with no notes and no link
  /// is deleted outright instead (see users.service saveSquad).
  archivedAt DateTime? @map("archived_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  squad      Squad?      @relation(fields: [squadId], references: [id], onDelete: Cascade)
  playerUser User?       @relation("SquadPlayerAccount", fields: [playerUserId], references: [id], onDelete: SetNull)
  notes      PlayerNote[]

  @@index([userId, sortOrder])
  @@index([squadId, sortOrder])
  /// Unique PER COACH, not per squad, and not globally.
  ///
  /// Not globally: a fourteen-year-old plays for their club on Sunday and
  /// their school on Wednesday and belongs on both rosters. A global unique
  /// would let whichever coach linked first lock the player out of everywhere
  /// else.
  ///
  /// Not per squad either, which is the subtler half. A second row for the
  /// same child under the same coach would give them TWO note histories — so
  /// a player moving up from the U13s to the U15s mid-season would lose their
  /// record at the moment it finally means something. One coach, one player,
  /// one row: moving squads moves the row, and the history follows.
  @@unique([userId, playerUserId])
  @@index([playerUserId, linkStatus])
  @@map("squad_players")
}

enum SquadLinkStatus {
  /// The coach has asked; the player has not answered yet.
  pending
  active
}

/// One piece of feedback from a coach to one player.
///
/// Everything here is seen by the player and their guardian. There is
/// deliberately no private "coach only" variant: a note a coach would not show
/// the player belongs in the club's safeguarding process, not in a tactics
/// app — and a child or parent has a subject access right to it regardless,
/// so "private" would be a promise we could not keep.
model PlayerNote {
  id            Int      @id @default(autoincrement())
  squadPlayerId Int      @map("squad_player_id")
  /// Who wrote it. Kept for audit even after the coach leaves the club.
  coachUserId   Int      @map("coach_user_id")
  /// The session that prompted it; null for a note left outside one.
  sessionId     Int?     @map("session_id")
  /// Optional animation — "this is the run I meant".
  boardId       Int?     @map("board_id")

  /// The coach's own words. Short on purpose: the tags carry the structure so
  /// the sentence can be casual, which is what makes 20 seconds per player
  /// achievable.
  body      String @db.VarChar(600)
  /// Tag keys from lib/feedback-tags.ts. The same tag can be a strength for
  /// one player and a work-on for another, so one vocabulary, two lists.
  ///
  /// `strengths` needs no @map because the field name and the column name are
  /// already identical. `workOns` does — without it Prisma asks MySQL for a
  /// column called `workOns`, which migration 20 never created. It shipped
  /// missing and took the whole player screen down with it.
  strengths Json   @default("[]")
  workOns   Json   @default("[]") @map("work_ons")

  /// Notes are written, reviewed, then sent as a batch. Nothing reaches a
  /// player (or their guardian) until the coach presses send.
  sentAt    DateTime? @map("sent_at")
  /// When the player first opened it. Drives a "seen" tick for the coach and
  /// nothing else — nobody is judged on it.
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  squadPlayer SquadPlayer      @relation(fields: [squadPlayerId], references: [id], onDelete: Cascade)
  coach       User             @relation("CoachNotes", fields: [coachUserId], references: [id], onDelete: Cascade)
  session     TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  board       CanvasBoard?     @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@index([squadPlayerId, createdAt])
  @@index([sessionId])
  @@map("player_notes")
}

// ---- Blog (marketing content, owner-managed) --------------------------------

model BlogPost {
  id             Int       @id @default(autoincrement())
  slug           String    @unique @db.VarChar(200)
  title          String    @db.VarChar(255)
  excerpt        String?   @db.Text
  // Markdown source; rendered client-side.
  content        String    @db.LongText
  coverImageKey  String?   @map("cover_image_key") @db.VarChar(500)
  tags           Json      @default("[]")
  status         PostStatus @default(draft)
  publishedAt    DateTime? @map("published_at")
  authorId       Int       @map("author_id")
  seoTitle       String?   @map("seo_title") @db.VarChar(255)
  seoDescription String?   @map("seo_description") @db.VarChar(320)
  readMinutes    Int       @default(3) @map("read_minutes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("blog_posts")
}

enum PostStatus {
  draft
  published
}

// ---- CRM leads (contact form submissions) ------------------------------------

/// Every email the system has tried to send.
///
/// Written by `sendMail` itself, not by the routes that call it — a route can
/// forget to log, and the one that forgets is the one you need a record of.
/// Failures are rows too: "we tried and it bounced" and "we never tried" look
/// identical to a coach waiting for a link, and only this table tells them
/// apart.
///
/// Not a queue and not an outbox: it records what happened, it does not drive
/// sending.
model EmailLog {
  id        Int            @id @default(autoincrement())
  /// Recipient as addressed. Kept verbatim even if the user later changes
  /// their email — the record is of what was sent WHERE, at the time.
  to        String         @db.VarChar(255)
  /// Which template ("account_setup", "password_reset", "player_note"…).
  /// A plain string rather than an enum: templates are added often, and a
  /// migration per template is a tax nobody pays happily.
  kind      String         @db.VarChar(40)
  subject   String         @db.VarChar(255)
  status    EmailStatus    @default(sent)
  /// The provider's complaint, trimmed. Null on success.
  error     String?        @db.VarChar(500)
  /// The account it was about, when there is one. SetNull so deleting a user
  /// never erases the record that they were emailed.
  userId    Int?           @map("user_id")
  /// The admin who pressed the button, for the ones a human triggered.
  actorId   Int?           @map("actor_id")
  createdAt DateTime       @default(now()) @map("created_at")

  user  User? @relation("EmailLogSubject", fields: [userId], references: [id], onDelete: SetNull)
  actor User? @relation("EmailLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("email_log")
}

enum EmailStatus {
  sent
  failed
  /// SMTP is not configured — nothing was attempted. Distinct from `failed`,
  /// because the fix is different: one is config, the other is the provider.
  skipped
}

/// A lead. Named ContactMessage because that is where it started — the
/// contact form — but the admin area has always called this table Leads, and
/// since migration 24 it holds leads added by hand and imported from a
/// spreadsheet too. `source` is what tells them apart.
model ContactMessage {
  id        Int           @id @default(autoincrement())
  firstName String        @map("first_name") @db.VarChar(100)
  lastName  String        @map("last_name") @db.VarChar(100)
  email     String        @db.VarChar(255)
  /// web = the website's contact form, direct = typed in by an admin,
  /// import = arrived on a spreadsheet.
  source    LeadSource    @default(web)
  /// Set by an admin when they know. `unknown` is the honest default: the
  /// contact form does not ask, and guessing from a message body would put a
  /// wrong label on a real person.
  kind      LeadKind      @default(unknown)
  /// The lead's OWN words. Null for anyone who has not written to us — a hand
  /// -added lead has no message, and '' would read as an empty one.
  message   String?       @db.Text
  /// The admin's note about them. Kept apart from `message` so a person's own
  /// words can never be confused with something we wrote about them.
  note      String?       @db.VarChar(500)
  status    LeadStatus    @default(new)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([source, kind])
  /// Not unique — the same person may use the contact form twice. Dedupe on
  /// import is the importer's job; see admin.routes.
  @@index([email])
  @@map("contact_messages")
}

enum LeadSource {
  web
  direct
  import
}

enum LeadKind {
  unknown
  coach
  club
}

enum LeadStatus {
  new
  replied
  closed
}

enum PageStatus {
  none
  pending
  approved
  rejected
  suspended
}

// Gallery photos on the public club page — awards, trophies, team photos,
// facilities. Capped at 8 per club in the upload route.
model ClubPhoto {
  id        Int      @id @default(autoincrement())
  clubId    Int      @map("club_id")
  imageKey  String   @map("image_key") @db.VarChar(500)
  caption   String?  @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, sortOrder])
  @@map("club_photos")
}

/// Who signed which agreement, when, from where.
///
/// A row per (user, kind, version) rather than columns on User: a signature is
/// a historical fact, not a current state. When terms change and someone
/// accepts 1.1, the record that they accepted 1.0 must survive — that record
/// is the evidence of what applied while it applied.
///
/// The COLLABORATION agreement also records its latest acceptance onto
/// `Collaborator` itself. Kept in both places deliberately: that row drives
/// the comped account and the commission, and this table is the evidence of
/// what was agreed and when. See migration 26.
model AgreementAcceptance {
  id       Int           @id @default(autoincrement())
  userId   Int           @map("user_id")
  kind     AgreementKind
  /// The version string as it was at acceptance. With the text kept in code
  /// and never edited in place, this reproduces exactly what they were shown.
  version  String        @db.VarChar(16)
  /// The name as the SIGNER typed it, which is not always their account name —
  /// a secretary signing for a club, or someone whose account says "Vince" but
  /// who signs "Vincent Okafor". Null only on rows predating migration 27.
  signerName String?     @db.VarChar(160) @map("signer_name")
  /// The signature as a PNG data URL. In the database rather than S3: a few
  /// kilobytes, read almost never, and it must outlive any bucket. See
  /// migration 27.
  signature  String?     @db.MediumText
  /// Set by the database, so it cannot be back-dated by whoever is signing.
  signedAt DateTime      @default(now()) @map("signed_at")
  /// Best-effort, and nullable: a missing IP must never refuse an acceptance.
  ip       String?       @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Re-posting is idempotent — double-clicking "I accept" is not two
  /// agreements.
  @@unique([userId, kind, version])
  @@index([userId, kind])
  @@map("agreement_acceptances")
}

enum AgreementKind {
  referral
  collaboration
}

/// A book: an ordered list of blocks, never a file. See migration 28 for why
/// that single decision buys translation, personalisation, chapter-at-a-time
/// serving and post-publish editing.
model Ebook {
  id       Int     @id @default(autoincrement())
  authorId Int     @map("author_id")
  title    String  @db.VarChar(160)
  subtitle String? @db.VarChar(200)
  slug     String  @unique @db.VarChar(180)
  blurb    String? @db.Text

  category EbookCategory @default(tactics)
  ageBand  EbookAgeBand  @default(all) @map("age_band")

  /// THE COVER IS DATA: {template, bg, art, font, weight, style, size}.
  /// Rendered as vectors by one shared component, so it is sharp at any size,
  /// identical everywhere, and needs no object storage — which matters, since
  /// S3 is currently failing in production with a placeholder key.
  cover Json

  status      EbookStatus @default(draft)
  /// Stamped on first APPROVAL and never moved — a book rejected twice and
  /// approved on the third pass must not look three months old in the shop.
  publishedAt DateTime?   @map("published_at")
  /// When the author last submitted it for review.
  submittedAt DateTime?   @map("submitted_at")
  /// Why it was sent back. Shown to the author; a rejection without one is
  /// the same as silence, and they just resubmit the identical book.
  reviewNote  String?     @map("review_note") @db.VarChar(500)
  /// Pence. 0 = free. Never a float.
  pricePence  Int         @default(0) @map("price_pence")
  /// The language the author actually wrote in; translations derive from it.
  language    String      @default("en") @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// RESTRICT: deleting an account must not delete books people have read.
  author   User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  chapters EbookChapter[]
  notes    EbookNote[]
  progress EbookProgress[]
  reviews  EbookReview[]
  stats    EbookDailyStat[]

  @@index([status, category, ageBand])
  @@index([authorId])
  /// The author's own list: "my books, newest first", by status.
  @@index([authorId, status])
  @@map("ebooks")
}

enum EbookCategory {
  tactics
  technique
  mindset
  goalkeeping
  fitness
  set_pieces
}

enum EbookAgeBand {
  u9_11
  u12_14
  u15_18
  adult
  all
}

enum EbookStatus {
  draft
  /// Submitted by the author, waiting for us. Only an owner moves it on.
  in_review
  published
  /// Sent back with a reason (`reviewNote`). The author can edit and resubmit.
  rejected
  archived
}

model EbookChapter {
  id        Int     @id @default(autoincrement())
  ebookId   Int     @map("ebook_id")
  title     String  @db.VarChar(200)
  sortOrder Int     @default(0) @map("sort_order")
  /// Readable without buying. A column, not "chapter 1 is always free": an
  /// author may want a later chapter as the sample.
  isSample  Boolean @default(false) @map("is_sample")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ebook  Ebook        @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  blocks EbookBlock[]
  notes  EbookNote[]

  @@index([ebookId, sortOrder])
  @@map("ebook_chapters")
}

model EbookBlock {
  id        Int            @id @default(autoincrement())
  chapterId Int            @map("chapter_id")
  kind      EbookBlockKind
  sortOrder Int            @default(0) @map("sort_order")
  /// Shape depends on `kind`. JSON rather than fifteen nullable columns — a
  /// quiz's answers and a board's id have nothing in common.
  data      Json

  createdAt DateTime @default(now()) @map("created_at")

  chapter EbookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  notes   EbookNote[]

  @@index([chapterId, sortOrder])
  @@map("ebook_blocks")
}

enum EbookBlockKind {
  text
  board
  /// Two boards side by side — "9v9 becomes 11v11".
  board_compare
  /// One board across several of its frames, as panels rather than a video.
  board_sequence
  /// A board with Setup and Coaching Points beside it.
  drill
  character
  your_turn
  quiz
  image
  quote
  /// A board that PLAYS on the page: its moves, looping, with a scrubber.
  animation
  /// "What would you do?" — a frozen moment, options, then the answer plays.
  decision
  /// A bar / line / pie / radar chart from a small table, in the cover's colours.
  chart
}

/// A reader's own highlight or note.
///
/// Private by default and never surfaced to the author — anything else and
/// people stop writing honestly. Survives a refund or an unpublish: their own
/// words are not licensed content.
model EbookNote {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  ebookId   Int     @map("ebook_id")
  chapterId Int?    @map("chapter_id")
  blockId   Int?    @map("block_id")
  /// Capped so an export of somebody's notes can never become a back door to
  /// the whole book.
  quote     String? @db.VarChar(600)
  body      String? @db.VarChar(2000)
  colour    NoteColour @default(yellow)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook   Ebook         @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  /// SET NULL, so a note survives the author reordering or deleting the
  /// passage it was attached to.
  chapter EbookChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  block   EbookBlock?   @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([userId, ebookId, createdAt])
  @@map("ebook_notes")
}

enum NoteColour {
  yellow
  green
  blue
}

/// One video export. See migration 30 for why this is a ledger, not a counter.
model VideoExport {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  boardId   Int?     @map("board_id")
  /// The plan in force at the time, so a cap can be explained after an upgrade.
  planSlug  String?  @map("plan_slug") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("video_exports")
}

model EbookProgress {
  userId        Int      @map("user_id")
  ebookId       Int      @map("ebook_id")
  lastChapterId Int?     @map("last_chapter_id")
  /// 0–100. Enough for "38%" and for the minimum-read rule ratings will need.
  percent       Int      @default(0) @db.TinyInt
  updatedAt     DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@id([userId, ebookId])
  @@map("ebook_progress")
}

/// A reader's rating of a book. One per reader per book (they edit, not add).
/// Only readers who got at least REVIEW_MIN_PERCENT through may write one —
/// a review of the blurb is not a review. `hidden` is the moderation switch:
/// kept, never deleted, so "why did my rating change" has an answer.
model EbookReview {
  id          Int      @id @default(autoincrement())
  ebookId     Int      @map("ebook_id")
  userId      Int      @map("user_id")
  rating      Int      @db.TinyInt
  body        String?  @db.VarChar(1000)
  hidden      Boolean  @default(false)
  /// The author's public answer. One, editable.
  authorReply String?  @map("author_reply") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ebookId, userId])
  @@index([ebookId, hidden, createdAt])
  @@map("ebook_reviews")
}

/// Per-book, per-day counters for the author dashboard. Aggregates only —
/// no row says who looked, so there is nothing personal to leak or delete.
model EbookDailyStat {
  ebookId     Int      @map("ebook_id")
  day         DateTime @db.Date
  pageViews   Int      @default(0) @map("page_views")
  sampleReads Int      @default(0) @map("sample_reads")
  chapterReads Int     @default(0) @map("chapter_reads")

  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@id([ebookId, day])
  @@map("ebook_daily_stats")
}
