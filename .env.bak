# Database — local MariaDB, dedicated app user (created via Homebrew MariaDB)
DATABASE_URL="mysql://tacticoach:tacticoach@localhost:3306/tacticoach"

# Server
PORT=3001
NODE_ENV=development

# JWT — freshly generated 64-byte secrets
JWT_ACCESS_SECRET=e33a62140700f211e99144a9e7f97b777c8e7add4482da6371c7d318b11156bacecdac23e76b7fd82aee00f3cc400579b958dca7c4e99a11ab1ae7732d80ebc0
JWT_REFRESH_SECRET=e29a745c3dd7591684571e2cc27bfdf47c91679c64b0b35c45ee1797984d73921738b1dc6a1a4605e1f4e54ed75f3a779af37c200effa68b986e1b1afbcf7c06
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3 — PLACEHOLDERS so env validation passes and the API boots.
# Replace with real values before using upload endpoints (logos, thumbnails, videos).
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
S3_BUCKET=tacticoach-uploads

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5280,http://localhost:3000

# Stripe — optional; billing routes return 503 until both are set
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5280
AI_PROVIDER=openai-compat
AI_BASE_URL=https://api.openai.com/v1
